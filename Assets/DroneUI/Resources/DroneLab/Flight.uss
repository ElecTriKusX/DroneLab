.pilot-instruments { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.pilot-hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(234, 238, 237); font-size: 18px; }
.pilot-branding { position: absolute; left: 30px; top: 25px; width: 540px; }
.pilot-brand { font-size: 30px; letter-spacing: 6px; -unity-font-style: bold; }
.pilot-caption { margin-top: 8px; font-size: 15px; color: rgb(207, 216, 213); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 510px; }
.pilot-source { margin-top: 6px; font-size: 12px; color: rgb(165, 177, 178); }
.flight-instrument { overflow: hidden; }
.flight-instrument-text { position: absolute; height: 24px; font-size: 16px; color: rgb(227, 234, 233); -unity-text-align: middle-center; white-space: nowrap; }
.flight-instrument-value { height: 30px; font-size: 23px; color: white; background-color: rgba(13, 17, 19, .87); border-width: 1px; border-color: rgba(209, 219, 217, .8); }
.pilot-compass { position: absolute; top: 24px; left: 50%; margin-left: -270px; width: 540px; height: 72px; background-color: rgba(15, 19, 21, .45); border-radius: 3px; }
.pilot-status { position: absolute; right: 30px; top: 25px; flex-direction: row; align-items: flex-start; }
.pilot-status-cell { padding: 9px 13px; margin-left: 9px; border-width: 1px; border-color: rgba(181, 193, 189, .45); border-radius: 4px; background-color: rgba(15, 19, 21, .82); font-size: 17px; }
.pilot-power { margin-left: 9px; }
.pilot-power .pilot-status-cell { margin-left: 0; }
.pilot-charge-track { height: 3px; background-color: rgba(116, 130, 130, .35); }
.pilot-charge-fill { height: 3px; background-color: rgb(218, 228, 224); width: 0%; }
.pilot-tapes { position: absolute; top: 175px; left: 30px; width: 195px; }
.pilot-tape-caption { font-size: 13px; margin-bottom: 5px; color: rgb(219, 229, 224); padding: 4px 6px; background-color: rgba(15, 19, 21, .68); }
.pilot-tape { width: 108px; height: 160px; margin-bottom: 18px; background-color: rgba(15, 19, 21, .38); border-radius: 3px; }
.pilot-surface { font-size: 13px; white-space: normal; padding: 6px; background-color: rgba(15, 19, 21, .72); }
.pilot-horizon { position: absolute; left: 30px; bottom: 112px; width: 210px; height: 210px; overflow: hidden; }
.pilot-attitude { position: absolute; left: 30px; bottom: 80px; width: 310px; font-size: 14px; padding: 5px 8px; background-color: rgba(15, 19, 21, .74); }
.pilot-fpv { position: absolute; left: 50%; top: 50%; width: 540px; height: 400px; margin-left: -270px; margin-top: -200px; }
.pilot-fpv-ladder { width: 540px; height: 400px; }
.pilot-map-panel { position: absolute; right: 30px; bottom: 104px; width: 290px; height: 352px; border-width: 1px; border-color: rgba(211, 221, 217, .6); border-radius: 5px; background-color: rgba(15, 19, 21, .84); }
.pilot-map-header { flex-direction: row; align-items: center; height: 40px; border-bottom-width: 1px; border-bottom-color: rgba(153, 172, 170, .25); }
.pilot-map-title { font-size: 14px; padding: 8px 12px; flex-grow: 1; }
.pilot-map-header .pilot-map-toggle { width: 32px; min-width: 32px; min-height: 28px; height: 28px; padding: 0; margin: 0 7px 0 0; font-size: 23px; }
.pilot-map-panel.collapsed { height: 40px; }
.pilot-map { width: 288px; height: 252px; }
.pilot-map-home { font-size: 15px; padding: 4px 12px; }
.pilot-climb { position: absolute; left: 50%; margin-left: -165px; width: 330px; bottom: 104px; padding: 8px 12px; -unity-text-align: middle-center; font-size: 19px; background-color: rgba(15, 19, 21, .75); border-radius: 3px; }
.pilot-wind { position: absolute; left: 30px; bottom: 38px; font-size: 16px; padding: 8px 12px; background-color: rgba(15, 19, 21, .8); border-width: 1px; border-color: rgba(181, 193, 189, .35); border-radius: 4px; }
.pilot-warning { position: absolute; top: 120px; left: 50%; width: 540px; margin-left: -270px; padding: 10px; font-size: 19px; -unity-text-align: middle-center; background-color: rgba(18, 22, 23, .88); border-width: 1px; border-color: rgba(217, 223, 215, .65); border-radius: 3px; }
.pilot-warning.critical { color: rgb(245, 183, 135); border-color: rgb(217, 153, 113); }
.pilot-navigation { position: absolute; bottom: 30px; right: 30px; flex-direction: row; }
.pilot-button { min-height: 43px; min-width: 114px; margin: 0 0 0 8px; padding: 8px 14px; font-size: 16px; color: rgb(229, 235, 232); background-color: rgba(15, 19, 21, .9); border-width: 1px; border-color: rgba(197, 208, 202, .6); border-radius: 4px; }
.pilot-button:hover, .pilot-button:focus { border-color: white; background-color: rgb(40, 46, 47); }
.pilot-button.selected { background-color: rgb(224, 230, 227); border-color: rgb(224, 230, 227); color: rgb(20, 24, 25); }
.pilot-camera-caption { position: absolute; bottom: 78px; right: 30px; font-size: 12px; color: rgb(196, 210, 205); background-color: rgba(15, 19, 21, .7); padding: 3px 7px; }
.pilot-help { position: absolute; right: 30px; bottom: 95px; width: 780px; padding: 23px; border-width: 1px; border-color: rgb(191, 201, 195); border-radius: 5px; background-color: rgb(23, 28, 30); }
.pilot-help-title { font-size: 19px; margin-bottom: 12px; }
.pilot-help-text { font-size: 16px; white-space: normal; margin-bottom: 10px; color: rgb(215, 223, 219); }
.cinema-hint { position: absolute; left: 50%; bottom: 30px; width: 680px; margin-left: -340px; align-items: center; padding: 10px; background-color: rgba(15, 19, 21, .7); border-radius: 4px; }
.cinema-hint-text { font-size: 15px; color: rgb(215, 226, 219); }

.flight-mode-picker { position: absolute; right: 330px; bottom: 90px; width: 230px; padding: 10px; background-color: rgb(23, 28, 30); border-width: 1px; border-color: rgb(145, 165, 159); border-radius: 5px; }
.flight-mode-picker .pilot-button { margin: 3px 0; -unity-text-align: middle-left; }

.flight-modal { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(7, 10, 11, .72); color: rgb(229, 236, 231); }
.flight-controls-card { width: 1140px; max-width: 94%; max-height: 90%; padding: 30px; background-color: rgb(23, 28, 30); border-width: 1px; border-color: rgb(170, 187, 178); border-radius: 7px; }
.flight-title { font-size: 25px; -unity-font-style: bold; margin-bottom: 14px; }
.flight-subtitle { font-size: 17px; -unity-font-style: bold; margin-top: 16px; margin-bottom: 10px; }
.flight-note { font-size: 14px; color: rgb(169, 187, 180); white-space: normal; margin: 6px 0 12px; }
.flight-controls-columns { flex-direction: row; height: 640px; margin-top: 15px; }
.flight-key-list { flex-grow: 1; width: 630px; margin-right: 24px; }
.flight-key-row { flex-direction: row; align-items: center; min-height: 42px; border-bottom-width: 1px; border-bottom-color: rgb(45, 58, 55); padding-right: 12px; }
.flight-key-name { flex-grow: 1; font-size: 16px; }
.flight-key-button { width: 140px; height: 34px; color: rgb(229, 236, 231); background-color: rgb(43, 52, 53); border-width: 1px; border-color: rgb(134, 159, 150); border-radius: 4px; font-size: 15px; }
.flight-control-options { width: 380px; padding: 5px 10px; }
.flight-control-options > .unity-base-field { margin-bottom: 22px; }
.flight-controls-footer { flex-direction: row; justify-content: flex-end; margin-top: 10px; }
.flight-workbench, .flight-scene-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(229, 236, 231); }
.flight-workbench-panel { position: absolute; top: 160px; right: 30px; bottom: 105px; width: 465px; padding: 22px; border-width: 1px; border-color: rgba(180, 200, 189, .6); border-radius: 5px; background-color: rgba(19, 25, 27, .95); }
.flight-workbench-panel.diagnostics { width: 580px; }
.flight-workbench-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 15px; }
.flight-workbench-tabs .pilot-button { min-width: 0; min-height: 35px; padding: 6px 10px; margin: 0 5px 6px 0; font-size: 14px; }
.flight-workbench-content { flex-grow: 1; }
.flight-workbench-content .unity-base-field { margin-top: 8px; margin-bottom: 10px; color: rgb(229, 236, 231); }
.flight-workbench-content .unity-base-field__label { min-width: 150px; max-width: 210px; white-space: normal; }
.flight-workbench-content .unity-base-field__input { background-color: rgb(40, 51, 52); color: rgb(231, 238, 232); }
.flight-workbench-content .unity-toggle { font-size: 15px; }
.flight-workbench-content .unity-composite-field { flex-direction: column; }
.flight-value-caption { margin-top: 13px; font-size: 13px; color: rgb(166, 187, 179); }
.flight-value { margin-top: 5px; padding-bottom: 9px; font-size: 17px; white-space: normal; border-bottom-width: 1px; border-bottom-color: rgba(103, 130, 120, .28); }
.flight-inline-actions { flex-direction: row; }
.flight-inline-actions .pilot-button { min-width: 0; margin-left: 0; margin-right: 10px; }
.flight-camera-image { width: 100%; height: 216px; margin-top: 18px; background-color: rgb(8, 12, 13); }
.flight-graph-card { position: absolute; left: 30px; bottom: 115px; width: 680px; height: 410px; padding: 8px 16px; border-width: 1px; border-color: rgba(180, 200, 189, .45); border-radius: 5px; background-color: rgba(19, 25, 27, .93); }
.flight-graph-card .flight-subtitle { margin-top: 0; margin-bottom: 4px; font-size: 14px; }
.sensor-plot { flex-grow: 1; }
.sensor-plot-controls { position: absolute; top: 0; left: 0; right: 0; height: 40px; flex-direction: row; align-items: center; }
.sensor-plot-controls .unity-base-field { margin: 0; align-items: center; }
.sensor-plot-controls .unity-base-field__label { min-width: 0; margin-right: 9px; font-size: 13px; }
.sensor-period { width: 188px; margin-right: 14px; }
.sensor-mode { flex-grow: 1; }
.sensor-plot-controls .drone-dropdown-trigger { height: 32px; min-height: 32px; }
.sensor-selector { height: 34px; margin: 2px 0 8px; align-items: center; }
.sensor-selector .unity-base-field__label { min-width: 68px; font-size: 13px; }
.sensor-selector .drone-dropdown-trigger { height: 32px; min-height: 32px; }
.sensor-axis-row { position: absolute; top: 45px; left: 64px; right: 0; height: 30px; flex-direction: row; align-items: center; }
.sensor-axis-toggle { flex-grow: 1; margin: 0 8px 0 0; font-size: 13px; }
.sensor-plot-unit { position: absolute; top: 78px; left: 0; width: 58px; font-size: 12px; -unity-text-align: middle-right; }
.sensor-plot-y { position: absolute; left: 0; width: 56px; height: 18px; font-size: 12px; -unity-text-align: middle-right; }
.sensor-plot-time { position: absolute; width: 52px; height: 18px; font-size: 12px; -unity-text-align: middle-center; }
.sensor-plot-empty { position: absolute; left: 80px; right: 20px; top: 130px; font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.sensor-plot-legend { position: absolute; bottom: 2px; left: 0; font-size: 12px; color: rgb(188, 209, 199); }
.flight-vector-caption { position: absolute; font-size: 14px; padding: 3px 7px; background-color: rgba(14, 20, 21, .85); border-radius: 3px; }
.flight-compact .pilot-compass { top: 110px; left: 30px; margin-left: 0; width: 450px; }
.flight-compact .pilot-branding { width: 410px; }
.flight-compact .pilot-caption { max-width: 400px; }
.flight-compact .pilot-warning { top: 190px; }
.flight-compact .pilot-tapes { top: 230px; }
.flight-compact .flight-workbench-panel { top: 205px; }
.flight-compact .flight-graph-card { width: 600px; }

.pilot-sensor-status { font-size: 12px; padding: 4px 12px; white-space: normal; color: rgb(187, 209, 198); }

/* Flight fields share the graphite theme, including nested numeric text inputs. */
.flight-ui { color: rgb(234, 236, 235); }
.flight-ui .unity-base-field__label, .flight-ui .unity-base-text-field__input, .flight-ui .unity-base-text-field__input .unity-text-element { color: rgb(234, 236, 235); }
.flight-ui .unity-base-text-field__input { background-color: rgb(30, 33, 35); border-width: 1px; border-color: rgb(98, 105, 107); border-radius: 4px; padding: 5px 8px; --unity-cursor-color: white; --unity-selection-color: rgba(166, 176, 178, .35); }
.flight-ui .unity-base-text-field__input .unity-text-element { background-color: transparent; --unity-cursor-color: white; --unity-selection-color: rgba(166, 176, 178, .35); }
.flight-ui .unity-base-text-field__input:focus { border-color: white; }
.flight-control-options .unity-base-slider .unity-text-field { min-width: 64px; width: 64px; margin-left: 10px; }
.flight-control-options .unity-base-slider { flex-direction: column; }
.flight-control-options .unity-base-slider > .unity-base-field__label { margin-bottom: 9px; }
.flight-control-options .unity-base-slider__tracker { height: 3px; background-color: rgb(86, 91, 93); border-width: 0; }
.flight-ui .unity-base-slider__dragger { background-color: rgb(230, 233, 232); border-color: rgb(230, 233, 232); border-radius: 3px; }
.flight-ui .unity-base-slider__dragger-border { border-width: 0; background-color: transparent; }
.flight-workbench-content .unity-composite-field > .unity-base-field__input { background-color: transparent; }
.flight-workbench-content .unity-composite-field__field .unity-base-field__label { min-width: 16px; max-width: 20px; width: 18px; font-size: 12px; }
.flight-workbench-content .unity-composite-field__field { min-width: 0; flex-grow: 1; margin: 0 4px; }
.flight-workbench-content .unity-composite-field > .unity-base-field__label { max-width: none; margin-bottom: 6px; }
.flight-ui .unity-toggle__checkmark { background-color: rgb(30, 33, 35); border-width: 1px; border-color: rgb(112, 119, 121); border-radius: 3px; }
.flight-purpose { margin-top: -4px; margin-bottom: 15px; }

/* Shared popup control in the same scaled reference stage. */
.drone-dropdown > .unity-base-field__input { padding: 0; border-width: 0; background-color: transparent; }
.drone-dropdown-trigger { flex-grow: 1; flex-direction: row; align-items: center; height: 40px; min-height: 40px; margin: 0; padding: 0 10px; border-width: 1px; border-color: rgb(119, 122, 123); border-radius: 6px; background-color: rgb(25, 26, 27); color: rgb(232, 233, 230); }
.drone-dropdown-trigger:hover, .drone-dropdown-trigger:focus { border-color: white; background-color: rgb(37, 39, 40); }
.drone-dropdown-value { flex-grow: 1; flex-basis: 0; font-size: 16px; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.drone-dropdown-arrow { width: 16px; height: 16px; flex-shrink: 0; margin-left: 8px; }
.drone-dropdown-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.drone-dropdown-popup { position: absolute; padding: 5px; background-color: rgb(27, 29, 30); border-width: 1px; border-color: rgb(145, 151, 151); border-radius: 7px; }
.drone-dropdown-option { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; height: 34px; min-height: 34px; flex-shrink: 0; margin: 0; padding: 0 10px; border-width: 0; border-radius: 4px; background-color: transparent; color: rgb(220, 224, 221); font-size: 16px; -unity-text-align: middle-left; }
.drone-dropdown-option:hover, .drone-dropdown-option:focus { background-color: rgb(55, 58, 59); color: white; }
.drone-dropdown-option.selected { background-color: rgb(42, 45, 46); border-left-width: 2px; border-left-color: white; }

/* Native scroll behavior with a quiet graphite track and rounded thumb. */
.graphite-scroller { width: 12px; min-width: 12px; margin-left: 14px; background-color: rgb(25, 26, 27); }
.graphite-scroller .unity-slider { margin: 0; padding: 0; background-color: rgb(25, 26, 27); }
.graphite-scroller .unity-base-slider__tracker { border-width: 0; background-color: rgb(25, 26, 27); }
.graphite-scroller .unity-base-slider__dragger {
    width: 10px; min-width: 10px; min-height: 40px; border-radius: 6px;
    background-color: rgb(64, 65, 66); border-width: 0;
}
.graphite-scroller .unity-base-slider__dragger:hover { background-color: rgb(84, 85, 86); }
.graphite-scroller .unity-base-slider__dragger:active { background-color: rgb(100, 101, 102); }
.graphite-scroller .unity-base-slider__dragger-border { background-color: transparent; border-width: 0; }
