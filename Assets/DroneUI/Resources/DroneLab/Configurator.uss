.dc-root {
    flex-grow: 1;
    background-color: rgba(6, 8, 10, 0.92);
    color: rgb(236, 241, 245);
    font-size: 13px;
}

.dc-header {
    height: 68px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 22px;
    padding-right: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 238, 245, 0.26);
    background-color: rgba(10, 13, 16, 0.96);
}

.dc-title-group {
    flex-direction: column;
}

.dc-title {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.dc-subtitle {
    margin-top: 2px;
    color: rgba(224, 233, 239, 0.58);
    font-size: 10px;
    letter-spacing: 2px;
}

.dc-badge {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 238, 245, 0.35);
    border-right-color: rgba(230, 238, 245, 0.35);
    border-top-color: rgba(230, 238, 245, 0.35);
    border-bottom-color: rgba(230, 238, 245, 0.35);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 7px;
    padding-bottom: 7px;
    min-width: 145px;
    -unity-text-align: middle-center;
}

.dc-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.dc-left {
    width: 300px;
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 8px;
    border-right-width: 1px;
    border-right-color: rgba(230, 238, 245, 0.22);
    background-color: rgba(12, 15, 18, 0.94);
}

.dc-right {
    width: 430px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgba(230, 238, 245, 0.22);
    background-color: rgba(12, 15, 18, 0.96);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
}

.dc-preview {
    flex-grow: 1;
    min-width: 250px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
}

.dc-preview-toolbar {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    height: 34px;
    flex-direction: row;
}

.dc-preview-toolbar > .dc-button {
    margin-right: 5px;
    min-width: 58px;
}

.dc-preview-hud {
    position: absolute;
    left: 14px;
    bottom: 14px;
    color: rgba(235, 242, 247, 0.72);
    background-color: rgba(4, 6, 8, 0.72);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.dc-selected-hud {
    position: absolute;
    right: 14px;
    bottom: 14px;
    max-width: 60%;
    color: rgba(235, 242, 247, 0.68);
    background-color: rgba(4, 6, 8, 0.72);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.dc-panel-heading {
    height: 30px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(235, 242, 247, 0.62);
    padding-top: 7px;
}

.dc-nav {
    margin-bottom: 10px;
}

.dc-nav-button {
    height: 34px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.dc-rotor-nav {
    margin-left: 12px;
    margin-bottom: 6px;
}

.dc-rotor-button {
    height: 29px;
    margin-bottom: 2px;
    -unity-text-align: middle-left;
    opacity: 0.8;
}

.dc-selected {
    background-color: rgba(66, 160, 205, 0.22);
    border-left-color: rgb(117, 213, 255);
    border-left-width: 2px;
}

.dc-hierarchy-scroll {
    flex-grow: 1;
    min-height: 120px;
    border-top-width: 1px;
    border-top-color: rgba(230, 238, 245, 0.14);
}

.dc-tree-row {
    height: 27px;
    flex-direction: row;
    align-items: center;
}

.dc-tree-expander {
    width: 25px;
    min-width: 25px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
}

.dc-tree-node {
    flex-grow: 1;
    height: 24px;
    -unity-text-align: middle-left;
    background-color: rgba(255,255,255,0.01);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.dc-inspector-scroll {
    flex-grow: 1;
    min-height: 0;
}

.dc-inspector {
    padding-bottom: 18px;
}

.dc-inspector-title {
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.dc-subheading {
    margin-top: 14px;
    margin-bottom: 6px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 238, 245, 0.18);
    -unity-font-style: bold;
    color: rgba(235, 242, 247, 0.75);
}

.dc-hint {
    white-space: normal;
    color: rgba(235, 242, 247, 0.55);
    margin-bottom: 9px;
}

.dc-button {
    height: 32px;
    background-color: rgba(27, 32, 37, 0.96);
    color: rgb(235, 241, 245);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(235, 241, 245, 0.28);
    border-right-color: rgba(235, 241, 245, 0.28);
    border-top-color: rgba(235, 241, 245, 0.28);
    border-bottom-color: rgba(235, 241, 245, 0.28);
}

.dc-button:hover {
    background-color: rgba(53, 62, 70, 0.98);
    border-left-color: rgba(235, 241, 245, 0.58);
    border-right-color: rgba(235, 241, 245, 0.58);
    border-top-color: rgba(235, 241, 245, 0.58);
    border-bottom-color: rgba(235, 241, 245, 0.58);
}

.dc-primary {
    background-color: rgba(36, 102, 128, 0.95);
    border-left-color: rgb(128, 220, 255);
    border-right-color: rgb(128, 220, 255);
    border-top-color: rgb(128, 220, 255);
    border-bottom-color: rgb(128, 220, 255);
}

.dc-inline {
    flex-direction: row;
    margin-bottom: 6px;
}

.dc-inline > .dc-button {
    margin-right: 5px;
    flex-grow: 1;
}

.dc-flex {
    flex-grow: 1;
    margin-right: 6px;
}

.dc-wide-field {
    margin-bottom: 6px;
}

.dc-field-block {
    margin-bottom: 8px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.025);
    border-left-width: 1px;
    border-left-color: rgba(235, 241, 245, 0.12);
}

.dc-field-row {
    flex-direction: row;
    align-items: center;
}

.dc-field-header {
    flex-direction: row;
    justify-content: space-between;
}

.dc-field-label {
    width: 142px;
}

.dc-number {
    flex-grow: 1;
    min-width: 90px;
}

.dc-unit {
    width: 80px;
    margin-left: 7px;
    color: rgba(235, 241, 245, 0.52);
}

.dc-requirement {
    color: rgb(118, 207, 245);
    font-size: 9px;
    min-width: 58px;
    -unity-text-align: middle-right;
}

.dc-source {
    margin-top: 4px;
    opacity: 0.78;
}

.dc-invalid {
    border-left-color: rgb(255, 92, 92);
    border-left-width: 2px;
}

.dc-readonly-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.dc-readonly-value {
    max-width: 60%;
    white-space: normal;
    color: rgba(235, 241, 245, 0.72);
    -unity-text-align: upper-right;
}

.dc-validation {
    height: 138px;
    min-height: 90px;
    border-top-width: 1px;
    border-top-color: rgba(235, 241, 245, 0.22);
    background-color: rgba(8, 11, 14, 0.97);
    padding-left: 12px;
    padding-right: 12px;
}

.dc-validation-header {
    height: 28px;
    -unity-font-style: bold;
    color: rgba(235, 241, 245, 0.63);
    padding-top: 6px;
}

.dc-issue-list {
    flex-grow: 1;
}

.dc-issue-list .dc-button {
    height: 27px;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.dc-issue-error {
    color: rgb(255, 132, 132);
}

.dc-issue-warning {
    color: rgb(255, 208, 114);
}

.dc-footer {
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    border-top-width: 1px;
    border-top-color: rgba(235, 241, 245, 0.18);
    background-color: rgb(8, 10, 12);
}

.dc-status {
    flex-grow: 1;
    white-space: normal;
    color: rgba(235, 241, 245, 0.64);
}

.dc-footer-buttons {
    flex-direction: row;
}

.dc-footer-buttons .dc-button {
    min-width: 125px;
    margin-left: 6px;
}
